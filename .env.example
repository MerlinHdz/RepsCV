# Local development defaults. Export variables in the shell; no automatic .env loading.
REPSCV_ENV=development
REPSCV_DATABASE_URL=sqlite:///./repscv.db
REPSCV_FRONTEND_DIST=frontend/dist
PORT=8000
REPSCV_PROXY_IPS=127.0.0.1
REPSCV_MAINTENANCE=0
# Production requires both of these, plus an attached persistent disk at /data:
# REPSCV_ENV=production
# REPSCV_PUBLIC_ORIGIN=https://your-service.onrender.com
# REPSCV_DATABASE_URL=sqlite:////data/repscv.db
# REPSCV_PROXY_IPS=*  # ONLY behind a platform proxy with no direct public app port
# REPSCV_SECURE_COOKIES=1  # automatic in production
